#!/bin/sh
# Writes src/locale/timezones.zig, the time zones Dazzle offers, from the
# tz database installed on this computer (as tzdata does on Debian and
# Ubuntu): each zone named in zone.tab (one or more for every country),
# and its rule for local time now and to come, the POSIX TZ string ending
# its TZif file (such as "NZST-12NZDT,M9.5.0,M4.1.0/3").
#
# Usage: scripts/timezones [zoneinfo directory]   (default /usr/share/zoneinfo)
#
# Run it again when the tz database changes (a country changes its
# offset, or its daylight saving time), and commit what it writes.
set -eu

ROOT=$(cd "$(dirname "$0")/.." && pwd)
ZONEINFO=${1:-/usr/share/zoneinfo}
OUT="$ROOT/src/locale/timezones.zig"
VERSION=$(cat "$ZONEINFO/tzdata.zi" 2>/dev/null | sed -n 's/^# version //p' | head -n 1)

{
	echo "//! The time zones Dazzle offers: their names (as the tz database's"
	echo "//! zone.tab has them), their rules for local time (POSIX TZ"
	echo "//! strings; see timezone.zig), and where their places are (zone.tab's"
	echo "//! coordinates, in degrees north and east). Written by"
	echo "//! scripts/timezones from tzdata ${VERSION:-(version unknown)}: do not"
	echo "//! edit."
	echo
	echo "pub const Zone = struct { name: []const u8, rule: []const u8, lat: f32 = 0, lon: f32 = 0, located: bool = true };"
	echo
	echo "pub const zones = [_]Zone{"
	echo "    .{ .name = \"UTC\", .rule = \"UTC0\", .located = false },"
	grep -v '^#' "$ZONEINFO/zone.tab" | cut -f2,3 | LC_ALL=C sort -t "$(printf '\t')" -k2 | while IFS="$(printf '\t')" read -r coords name; do
		rule=$(tail -n 1 "$ZONEINFO/$name")
		# ISO 6709: +DDMM+DDDMM or +DDMMSS+DDDMMSS.
		place=$(echo "$coords" | awk '{
			s = $0; n = length(s)
			for (i = 2; i <= n; i++) { c = substr(s, i, 1); if (c == "+" || c == "-") break }
			la = substr(s, 1, i - 1); lo = substr(s, i)
			printf "%.4f %.4f", dms(la, 2), dms(lo, 3)
		}
		function dms(t, d,   sign, v) {
			sign = substr(t, 1, 1) == "-" ? -1 : 1
			v = substr(t, 2 + d, 2) / 60 + substr(t, 2, d)
			if (length(t) > 1 + d + 2) v += substr(t, 4 + d, 2) / 3600
			return sign * v
		}')
		lat=${place% *}
		lon=${place#* }
		echo "    .{ .name = \"$name\", .rule = \"$rule\", .lat = $lat, .lon = $lon },"
	done
	echo "};"
} >"$OUT"
echo "Wrote $(grep -c '\.name' "$OUT") zones to $OUT"
