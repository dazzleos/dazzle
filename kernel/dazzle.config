# Dazzle kernel configuration fragment.
#
# Applied on top of `make tinyconfig` by `zig build`, to the Raspberry Pi
# kernel, with kernel/armv6.config (kernel.img: the Pi 1, Zero and Zero W),
# kernel/armv7.config (kernel7.img: the Pi 2, 3, Zero 2 W and 4) or
# kernel/arm64.config (kernel8.img: the Pi 5).
# Every option here should be justified; the aim is the smallest kernel that
# boots the Raspberry Pi boards and exposes the vc4/v3d DRM drivers.

# --- Platform: BCM2835/6/7/2711/2712 -------------------------------------------
# tinyconfig on ARM defaults to a no-MMU Cortex-M build.
CONFIG_MMU=y
CONFIG_ARCH_BCM=y
CONFIG_ARCH_BCM2835=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# --- Core features needed by our userspace -----------------------------------
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_BINFMT_ELF=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_SHMEM=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_TTY=y
# User and group IDs and capabilities. Without this every process is
# effectively root; with it, init can run the demo as an unprivileged user.
CONFIG_MULTIUSER=y

# The 32-bit time system calls (clock_gettime, clock_settime, nanosleep,
# utimensat, ...) beside their 64-bit versions. Dazzle's own code uses the
# 64-bit ones (sys.zig), but Zig's standard library uses the 32-bit ones on
# 32-bit ARM: without them its clock reads 1970 on the Zero (which has no
# vDSO to read it without a system call), and HTTPS (the app store) fails
# with "the clock is not set yet". tinyconfig leaves them out.
CONFIG_COMPAT_32BIT_TIME=y

# --- Serial console -----------------------------------------------------------
# Zero W and Pi 3 A+: mini UART (uart1) on GPIO 14/15 (their PL011 talks to
# Bluetooth). Zero: PL011 (uart0) on GPIO 14/15.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_EXTENDED=y
CONFIG_SERIAL_8250_SHARE_IRQ=y
CONFIG_SERIAL_8250_BCM2835AUX=y
# CONFIG_SERIAL_8250_16550A_VARIANTS is not set
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y

# --- Firmware interface, clocks and power domains ----------------------------
CONFIG_MAILBOX=y
CONFIG_BCM2835_MBOX=y
CONFIG_RASPBERRYPI_FIRMWARE=y
CONFIG_RASPBERRYPI_POWER=y
CONFIG_COMMON_CLK=y
CONFIG_CLK_BCM2835=y
CONFIG_CLK_RASPBERRYPI=y
CONFIG_PM=y
# Restarting (after an update, from Settings) goes through the SoC's
# watchdog: its driver is the board's restart handler. (The watchdog only
# runs if something starts it.)
CONFIG_WATCHDOG=y
CONFIG_BCM2835_WDT=y

# GPIO: Settings shows what each pin does by reading the GPIO registers
# (/dev/gpiomem, read-only, which disturbs nothing), and sets pins up
# through the GPIO character device.
CONFIG_GPIO_CDEV=y
CONFIG_RASPBERRYPI_GPIOMEM=y
# The Data Logger reads I2C devices on the header's bus (config.txt turns
# it on) through i2c-dev, and serial ports: the header's UART, and USB
# serial adapters (CDC ACM boards such as Arduinos and Picos, and the
# common FTDI, CP210x, CH340 and PL2303 adapters).
CONFIG_I2C_CHARDEV=y
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_PL2303=y

# HDMI DDC (EDID) goes over the BCM2835 I2C controller.
CONFIG_I2C=y
CONFIG_I2C_BCM2835=y

# --- Graphics: vc4 (HVS/HDMI display + V3D 3D engine) ------------------------
# The V3D has no MMU, so every buffer it touches comes from CMA. The device
# tree reserves a 64MB CMA pool, too little for the shell and two apps at
# 1080p (each window has up to three 7MB buffers): cmdline.txt enlarges it
# with cma=128M.
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_DRM=y
CONFIG_DRM_VC4=y
# CONFIG_DRM_VC4_HDMI_CEC is not set
# CONFIG_DRM_FBDEV_EMULATION is not set

# vc4 hard-depends on ALSA SoC for HDMI audio.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
# The HDMI encoder sets up its audio DMA channel while probing and fails
# without a DMA engine, which leaves vc4 without a display and no
# /dev/dri/card0.
CONFIG_DMADEVICES=y
CONFIG_DMA_BCM2835=y

# --- Networking: USB Ethernet adapter on the USB port -------------------------
# Init's network manager configures the interface (DHCP or static) in the
# background, so the kernel's own boot-time configuration (IP_PNP) is off
# and boot never waits for the network.
CONFIG_NET=y
# Unix sockets: Wayland clients talk to dazzle-shell over one.
CONFIG_UNIX=y
# Packet sockets: the WPA supplicant sends and receives EAPOL frames over one.
CONFIG_PACKET=y
CONFIG_INET=y
# CONFIG_IP_PNP is not set
# CONFIG_IPV6 is not set
# NAT / masquerading for Wi-Fi hotspot internet sharing (configured over
# nfnetlink by init's network manager; see nat.zig).
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NETDEVICES=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
# Mainline's driver for the BCM283x USB controller, which `dtoverlay=dwc2`
# selects (for USB gadget mode, say), and which QEMU's emulation of it works
# with (the Raspberry Pi kernel's dwc_otg driver is enabled in armv6.config
# and armv7.config).
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_HOST=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
# Generic CDC Ethernet (also what QEMU's usb-net presents).
CONFIG_USB_NET_CDCETHER=y
# Realtek RTL8152/RTL8153: most cheap USB 3 / USB-C gigabit dongles.
CONFIG_USB_RTL8152=y
# ASIX AX88772 (USB 2) and AX88179/178A (USB 3).
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
# SMSC LAN95xx / Microchip LAN78xx (USB hubs with Ethernet, Pi 1-3 style).
CONFIG_USB_NET_SMSC95XX=y
CONFIG_USB_LAN78XX=y

# --- The SD card: the boot partition, and the space after it for files ----
# The firmware loads the system (a slot's kernel and initramfs) from the
# card's FAT partition into memory; init mounts that partition too, read
# only, at /boot (for updates). The setup app gives the rest of the card
# a partition of its own, with an ext2-format filesystem that the ext4
# driver mounts at /data (the ext2 driver is deprecated). The card is on
# the SDHOST controller.
CONFIG_BLOCK=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BCM2835=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
# VFAT's defaults: code page 437 for short names, ISO 8859-1 for long ones.
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# --- USB drives -----------------------------------------------------------------
# USB sticks and disks (USB mass storage, a SCSI disk to the kernel: sda,
# sda1, ...), which the media manager mounts in /media: FAT (above), exFAT
# (what bigger sticks come with), NTFS (Windows' disks) and ext4. Their
# names are UTF-8.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y
CONFIG_NLS_UTF8=y

# --- Wi-Fi: the Zero W's CYW43430 and the 3 A+'s CYW43455, on SDIO ----------
# The chip hangs off the SDHCI controller (the SD card is on SDHOST). The
# driver loads the chip's firmware from /os/firmware/brcm in the initramfs
# (firmware_class.path=/os/firmware in cmdline.txt). There is no regulatory database
# (regulatory.db), so cfg80211 keeps to the world regulatory domain, the
# most restrictive; scanning needs nothing more.
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_IPROC=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_FW_LOADER=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y

# --- Health: SoC temperature and supply voltage ------------------------------
# The firmware slows the CPU and GPU when the SoC is hot or the supply
# voltage drops. The thermal sensor gives the demo the temperature
# (/sys/class/thermal), and the hwmon driver logs "Undervoltage detected!".
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_BCM2835_THERMAL=y
CONFIG_HWMON=y
CONFIG_SENSORS_RASPBERRYPI_HWMON=y

# --- Input: USB keyboards and mice -------------------------------------------
# HID devices appear as /dev/input/eventN; dazzle-shell reads them.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# --- Camera: the Raspberry Pi Camera Module on the CSI connector -------------
# The sensor (Camera Module v1's OV5647 or v2's IMX219) is controlled over
# I2C (routed to the camera connector by i2c-mux-pinctrl) and sends raw
# Bayer frames over CSI-2 to the Unicam receiver, which writes them to
# memory: /dev/videoN, with the sensor as /dev/v4l-subdevN (its formats and
# controls). There is no image processor in mainline for these boards: the
# Camera app makes pictures of the raw frames itself. Which sensor is there
# comes from the firmware's camera_auto_detect, which applies its device
# tree overlay (config.txt). The camera's power line (on the firmware GPIO
# expander on the Pi 3) and clock are a fixed regulator and clock.
CONFIG_I2C_MUX=y
CONFIG_I2C_MUX_PINCTRL=y
CONFIG_GPIO_RASPBERRYPI_EXP=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_MEDIA_PLATFORM_DRIVERS=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_VIDEO_BCM2835_UNICAM=y
CONFIG_VIDEO_BCM2835_UNICAM_LEGACY=y
CONFIG_VIDEO_CAMERA_SENSOR=y
CONFIG_VIDEO_IMX219=y
CONFIG_VIDEO_OV5647=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# --- Video decoding: the VideoCore VPU's hardware codec (/dev/video10) -------
# The bcm2835-codec V4L2 memory-to-memory driver talks over VCHIQ (MMAL) and
# shared CMA memory to the GPU firmware's ril.video_decode service, decoding
# H.264, MJPEG, MPEG-4 and H.263 in hardware for the Files app.
CONFIG_STAGING=y
CONFIG_BCM_VIDEOCORE=y
CONFIG_BCM2835_VCHIQ=y
CONFIG_VIDEO_CODEC_BCM2835=y

# --- Audio: HDMI (via vc4), the 3.5 mm headphone jack, and USB audio ---------
# vc4-hdmi registers an ALSA card with CONFIG_SND_SOC above; bcm2835-audio
# drives the onboard PWM headphone jack over VCHIQ (when dtparam=audio=on is
# in config.txt), and snd-usb-audio drives USB speakers, headsets and DACs.
CONFIG_SND_BCM2835=y
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y

# --- Things we explicitly do not want -----------------------------------------
# CONFIG_MODULES is not set
# CONFIG_FB is not set
# CONFIG_VT is not set
# CONFIG_DRM_SIMPLEDRM is not set
