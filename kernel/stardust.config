# Stardust kernel configuration fragment.
#
# Applied on top of `make tinyconfig` for ARCH=arm by `zig build`.
# Every option here should be justified; the aim is the smallest kernel that
# boots a Raspberry Pi Zero / Zero W and a Pi 3 A+, and exposes the vc4 DRM
# driver.

# --- Platform: BCM2835 (ARM1176JZF-S, ARMv6K) and BCM2837 (Cortex-A53) --------
# One 32-bit kernel for both: built for ARMv6 and ARMv7 (the A53 runs in
# AArch32 mode, as an ARMv7-compatible core), with the board's device tree
# choosing the rest.
# tinyconfig on ARM defaults to a no-MMU Cortex-M build.
CONFIG_MMU=y
CONFIG_ARCH_MULTI_V6=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_BCM=y
# The Pi 3 A+ has four cores. The same kernel runs on the Zero's single
# core: SMP_ON_UP patches the SMP-only instructions out at boot.
CONFIG_SMP=y
CONFIG_SMP_ON_UP=y
CONFIG_NR_CPUS=4
CONFIG_ARCH_BCM2835=y
CONFIG_AEABI=y
CONFIG_VFP=y
CONFIG_KERNEL_XZ=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# --- Core features needed by our userspace -----------------------------------
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_BINFMT_ELF=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_SHMEM=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_TTY=y
# User and group IDs and capabilities. Without this every process is
# effectively root; with it, init can run the demo as an unprivileged user.
CONFIG_MULTIUSER=y

# --- Serial console -----------------------------------------------------------
# Zero W and Pi 3 A+: mini UART (uart1) on GPIO 14/15 (their PL011 talks to
# Bluetooth). Zero: PL011 (uart0) on GPIO 14/15.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_EXTENDED=y
CONFIG_SERIAL_8250_SHARE_IRQ=y
CONFIG_SERIAL_8250_BCM2835AUX=y
# CONFIG_SERIAL_8250_16550A_VARIANTS is not set
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y

# --- Firmware interface, clocks and power domains ----------------------------
CONFIG_MAILBOX=y
CONFIG_BCM2835_MBOX=y
CONFIG_RASPBERRYPI_FIRMWARE=y
CONFIG_RASPBERRYPI_POWER=y
CONFIG_COMMON_CLK=y
CONFIG_CLK_BCM2835=y
CONFIG_CLK_RASPBERRYPI=y
CONFIG_PM=y

# HDMI DDC (EDID) goes over the BCM2835 I2C controller.
CONFIG_I2C=y
CONFIG_I2C_BCM2835=y

# --- Graphics: vc4 (HVS/HDMI display + V3D 3D engine) ------------------------
# The V3D has no MMU, so every buffer it touches comes from CMA. The device
# tree reserves a 64MB CMA pool, too little for the shell and two apps at
# 1080p (each window has up to three 7MB buffers): cmdline.txt enlarges it
# with cma=128M.
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_DRM=y
CONFIG_DRM_VC4=y
# CONFIG_DRM_VC4_HDMI_CEC is not set
# CONFIG_DRM_FBDEV_EMULATION is not set

# vc4 hard-depends on ALSA SoC for HDMI audio.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
# The HDMI encoder sets up its audio DMA channel while probing and fails
# without a DMA engine, which leaves vc4 without a display and no
# /dev/dri/card0.
CONFIG_DMADEVICES=y
CONFIG_DMA_BCM2835=y

# --- Networking: USB Ethernet adapter on the USB port -------------------------
# (The Zero W's and Pi 3 A+'s Wi-Fi is not supported yet.)
# Init's network manager configures the interface (DHCP or static) in the
# background, so the kernel's own boot-time configuration (IP_PNP) is off
# and boot never waits for the network.
CONFIG_NET=y
# Unix sockets: Wayland clients talk to stardust-shell over one.
CONFIG_UNIX=y
CONFIG_INET=y
# CONFIG_IP_PNP is not set
# CONFIG_IPV6 is not set
CONFIG_NETDEVICES=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_HOST=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
# Generic CDC Ethernet (also what QEMU's usb-net presents).
CONFIG_USB_NET_CDCETHER=y
# Realtek RTL8152/RTL8153: most cheap USB 3 / USB-C gigabit dongles.
CONFIG_USB_RTL8152=y
# ASIX AX88772 (USB 2) and AX88179/178A (USB 3).
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
# SMSC LAN95xx / Microchip LAN78xx (USB hubs with Ethernet, Pi 1-3 style).
CONFIG_USB_NET_SMSC95XX=y
CONFIG_USB_LAN78XX=y

# --- Health: SoC temperature and supply voltage ------------------------------
# The firmware slows the CPU and GPU when the SoC is hot or the supply
# voltage drops. The thermal sensor gives the demo the temperature
# (/sys/class/thermal), and the hwmon driver logs "Undervoltage detected!".
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_BCM2835_THERMAL=y
CONFIG_HWMON=y
CONFIG_SENSORS_RASPBERRYPI_HWMON=y

# --- Input: USB keyboards and mice -------------------------------------------
# HID devices appear as /dev/input/eventN; stardust-shell reads them.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# --- Things we explicitly do not want -----------------------------------------
# CONFIG_MODULES is not set
# CONFIG_FB is not set
# CONFIG_VT is not set
# CONFIG_DRM_SIMPLEDRM is not set
