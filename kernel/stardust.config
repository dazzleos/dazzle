# Stardust kernel configuration fragment.
#
# Applied on top of `make tinyconfig` for ARCH=arm by scripts/build-kernel.sh.
# Every option here should be justified; the aim is the smallest kernel that
# boots a Raspberry Pi Zero / Zero W and exposes the vc4 DRM driver.

# --- Platform: BCM2835 (ARM1176JZF-S, ARMv6K) --------------------------------
# tinyconfig on ARM defaults to a no-MMU Cortex-M build.
CONFIG_MMU=y
CONFIG_ARCH_MULTI_V6=y
# CONFIG_ARCH_MULTI_V7 is not set
CONFIG_ARCH_BCM=y
CONFIG_ARCH_BCM2835=y
CONFIG_AEABI=y
CONFIG_VFP=y
CONFIG_KERNEL_XZ=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# --- Core features needed by our userspace -----------------------------------
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_BINFMT_ELF=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_SHMEM=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_TTY=y
# User and group IDs and capabilities. Without this every process is
# effectively root; with it, init can run the demo as an unprivileged user.
CONFIG_MULTIUSER=y

# --- Serial console -----------------------------------------------------------
# Zero W: mini UART (uart1) on GPIO 14/15. Zero: PL011 (uart0) on GPIO 14/15.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_EXTENDED=y
CONFIG_SERIAL_8250_SHARE_IRQ=y
CONFIG_SERIAL_8250_BCM2835AUX=y
# CONFIG_SERIAL_8250_16550A_VARIANTS is not set
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y

# --- Firmware interface, clocks and power domains ----------------------------
CONFIG_MAILBOX=y
CONFIG_BCM2835_MBOX=y
CONFIG_RASPBERRYPI_FIRMWARE=y
CONFIG_RASPBERRYPI_POWER=y
CONFIG_COMMON_CLK=y
CONFIG_CLK_BCM2835=y
CONFIG_CLK_RASPBERRYPI=y
CONFIG_PM=y

# HDMI DDC (EDID) goes over the BCM2835 I2C controller.
CONFIG_I2C=y
CONFIG_I2C_BCM2835=y

# --- Graphics: vc4 (HVS/HDMI display + V3D 3D engine) ------------------------
# The V3D has no MMU, so every buffer it touches comes from CMA. The device
# tree reserves a 64MB CMA pool; cmdline.txt can enlarge it with cma=.
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_DRM=y
CONFIG_DRM_VC4=y
# CONFIG_DRM_VC4_HDMI_CEC is not set
# CONFIG_DRM_FBDEV_EMULATION is not set

# vc4 hard-depends on ALSA SoC for HDMI audio.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
# The HDMI encoder sets up its audio DMA channel while probing and fails
# without a DMA engine, which leaves vc4 without a display and no
# /dev/dri/card0.
CONFIG_DMADEVICES=y
CONFIG_DMA_BCM2835=y

# --- Networking: USB Ethernet adapter on the OTG port ------------------------
# Init's network manager configures the interface (DHCP or static) in the
# background, so the kernel's own boot-time configuration (IP_PNP) is off
# and boot never waits for the network.
CONFIG_NET=y
CONFIG_INET=y
# CONFIG_IP_PNP is not set
# CONFIG_IPV6 is not set
CONFIG_NETDEVICES=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_HOST=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
# Generic CDC Ethernet (also what QEMU's usb-net presents).
CONFIG_USB_NET_CDCETHER=y
# Realtek RTL8152/RTL8153: most cheap USB 3 / USB-C gigabit dongles.
CONFIG_USB_RTL8152=y
# ASIX AX88772 (USB 2) and AX88179/178A (USB 3).
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
# SMSC LAN95xx / Microchip LAN78xx (USB hubs with Ethernet, Pi 1-3 style).
CONFIG_USB_NET_SMSC95XX=y
CONFIG_USB_LAN78XX=y

# --- Things we explicitly do not want -----------------------------------------
# CONFIG_MODULES is not set
# CONFIG_FB is not set
# CONFIG_VT is not set
# CONFIG_DRM_SIMPLEDRM is not set
