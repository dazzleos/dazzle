# Stardust kernel configuration fragment.
#
# Applied on top of `make tinyconfig` for ARCH=arm by scripts/build-kernel.sh.
# Every option here should be justified; the aim is the smallest kernel that
# boots a Raspberry Pi Zero / Zero W and exposes the vc4 DRM driver.

# --- Platform: BCM2835 (ARM1176JZF-S, ARMv6K) --------------------------------
# tinyconfig on ARM defaults to a no-MMU Cortex-M build.
CONFIG_MMU=y
CONFIG_ARCH_MULTI_V6=y
# CONFIG_ARCH_MULTI_V7 is not set
CONFIG_ARCH_BCM=y
CONFIG_ARCH_BCM2835=y
CONFIG_AEABI=y
CONFIG_VFP=y
CONFIG_KERNEL_XZ=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# --- Core features needed by our userspace -----------------------------------
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_BINFMT_ELF=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_SHMEM=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_TTY=y

# --- Serial console -----------------------------------------------------------
# Zero W: mini UART (uart1) on GPIO 14/15. Zero: PL011 (uart0) on GPIO 14/15.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_EXTENDED=y
CONFIG_SERIAL_8250_SHARE_IRQ=y
CONFIG_SERIAL_8250_BCM2835AUX=y
# CONFIG_SERIAL_8250_16550A_VARIANTS is not set
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y

# --- Firmware interface, clocks and power domains ----------------------------
CONFIG_MAILBOX=y
CONFIG_BCM2835_MBOX=y
CONFIG_RASPBERRYPI_FIRMWARE=y
CONFIG_RASPBERRYPI_POWER=y
CONFIG_COMMON_CLK=y
CONFIG_CLK_BCM2835=y
CONFIG_CLK_RASPBERRYPI=y
CONFIG_PM=y

# HDMI DDC (EDID) goes over the BCM2835 I2C controller.
CONFIG_I2C=y
CONFIG_I2C_BCM2835=y

# --- Graphics: vc4 (HVS/HDMI display + V3D 3D engine) ------------------------
# The V3D has no MMU, so every buffer it touches comes from CMA. The device
# tree reserves a 64MB CMA pool; cmdline.txt can enlarge it with cma=.
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_DRM=y
CONFIG_DRM_VC4=y
# CONFIG_DRM_VC4_HDMI_CEC is not set
# CONFIG_DRM_FBDEV_EMULATION is not set

# vc4 hard-depends on ALSA SoC for HDMI audio.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y

# --- Things we explicitly do not want -----------------------------------------
# CONFIG_MODULES is not set
# CONFIG_FB is not set
# CONFIG_VT is not set
# CONFIG_DRM_SIMPLEDRM is not set
