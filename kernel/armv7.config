# kernel7.img: the Raspberry Pi 2, 3, Zero 2 W and 4 (BCM2836's Cortex-A7,
# BCM2837's Cortex-A53 or BCM2711's Cortex-A72 in AArch32), with
# kernel/dazzle.config. Four cores.
CONFIG_ARCH_MULTI_V7=y
# CONFIG_ARCH_MULTI_V6 is not set
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_AEABI=y
CONFIG_VFP=y
CONFIG_KERNEL_XZ=y
CONFIG_USB_DWCOTG=y
# ARM instructions, as the Raspberry Pi kernel is built: the USB driver's
# fast interrupt handler (dwc_otg's FIQ) is ARM code.
# CONFIG_THUMB2_KERNEL is not set

# --- Raspberry Pi 4 (BCM2711 / VideoCore VI) ----------------------------------
# Large Physical Address Extension (LPAE): 36-bit physical addressing for the
# Pi 4's PCIe outbound window (at 0x6_00000000) and boards with >1 GB of RAM.
CONFIG_ARM_LPAE=y
# VideoCore VI 3D engine (V3D 4.2, /dev/dri/renderD128).
CONFIG_DRM_V3D=y
# BCM2711 HDMI DVP clock/reset controller and AON L2 interrupt controller,
# which vc4's HVS5/HDMI0/HDMI1 display pipeline requires on the Pi 4.
CONFIG_CLK_BCM2711_DVP=y
CONFIG_BRCMSTB_L2_IRQ=y
CONFIG_RESET_CONTROLLER=y
CONFIG_RESET_RASPBERRYPI=y
CONFIG_RESET_BRCMSTB=y
# BCM2711 GPIO, firmware GPIO expander and SD card 1.8V/3.3V switching regulator.
CONFIG_GPIO_BRCMSTB=y
CONFIG_GPIO_RASPBERRYPI_EXP=y
CONFIG_REGULATOR_GPIO=y
# BCM2711 AVS thermal sensor.
CONFIG_MFD_SYSCON=y
CONFIG_BCM2711_THERMAL=y
# Pi 4 USB ports (VL805 xHCI controller over the BCM2711 PCIe root complex)
# and onboard Gigabit Ethernet (GENET v5 + BCM54213PE RGMII PHY).
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIE_BRCMSTB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_BCMGENET=y
CONFIG_MDIO_BCM_UNIMAC=y
CONFIG_BROADCOM_PHY=y

