# kernel7.img: the Raspberry Pi 2, 3 and Zero 2 W (BCM2836's Cortex-A7, or
# BCM2837's Cortex-A53 in AArch32), with kernel/dazzle.config. Four cores.
CONFIG_ARCH_MULTI_V7=y
# CONFIG_ARCH_MULTI_V6 is not set
CONFIG_SMP=y
CONFIG_NR_CPUS=4
# ARM instructions, as the Raspberry Pi kernel is built: the USB driver's
# fast interrupt handler (dwc_otg's FIQ) is ARM code.
# CONFIG_THUMB2_KERNEL is not set
