# kernel.img: the Raspberry Pi 1, Zero and Zero W (BCM2835, ARM1176JZF-S,
# ARMv6K), with kernel/dazzle.config. One core: no SMP (the Raspberry Pi
# kernel's BCM2835 interrupt handling assumes the BCM2836's with SMP).
CONFIG_ARCH_MULTI_V6=y
# CONFIG_ARCH_MULTI_V7 is not set
# CONFIG_SMP is not set
# The kernel's default (and Raspberry Pi's), which tinyconfig turns off:
# DMA memory mapped non-cacheable rather than strongly ordered. The GPIO
# registers' driver (gpiomem, see dazzle.config) needs it.
CONFIG_ARM_DMA_MEM_BUFFERABLE=y
