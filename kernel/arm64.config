# kernel8.img: the Raspberry Pi 5, 500 and Compute Module 5 (BCM2712's
# Cortex-A76 in AArch64), with kernel/dazzle.config. Four cores, 4 KB pages
# and 32-bit EL0 userspace compatibility (CONFIG_COMPAT=y) so the same 32-bit
# ARM Dazzle system and apps run unmodified.
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_ARM64_4K_PAGES=y
# CONFIG_ARM64_16K_PAGES is not set
CONFIG_COMPAT=y
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_COMPAT=y

# --- Raspberry Pi 5 (BCM2712 / VideoCore VII / RP1 Southbridge) ---------------
CONFIG_ARCH_BRCMSTB=y
CONFIG_ARM_GIC=y
CONFIG_BRCMSTB_L2_IRQ=y
# VideoCore VII 3D engine (V3D 7.1, /dev/dri/renderD128).
CONFIG_DRM_V3D=y
# BCM2712 HDMI DVP clock/reset controllers and AVS thermal sensor.
CONFIG_CLK_BCM2711_DVP=y
CONFIG_RESET_CONTROLLER=y
CONFIG_RESET_RASPBERRYPI=y
CONFIG_RESET_BRCMSTB=y
CONFIG_RESET_BRCMSTB_RESCAL=y
CONFIG_MFD_SYSCON=y
CONFIG_BCM2711_THERMAL=y
CONFIG_BRCMSTB_THERMAL=y
# BCM2712 GPIO, firmware GPIO expander and SD card 1.8V/3.3V switching regulator.
CONFIG_GPIO_BRCMSTB=y
CONFIG_GPIO_RASPBERRYPI_EXP=y
CONFIG_REGULATOR_GPIO=y
# BCM2712 SD card and Wi-Fi SDHCI controller.
CONFIG_MMC_SDHCI_BRCMSTB=y
CONFIG_I2C_BRCMSTB=y
# PCIe root complex (connects BCM2712 to the RP1 southbridge and M.2 HATs).
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIE_BRCMSTB=y
# RP1 PCIe southbridge (clocks, GPIO/pinctrl, I2C, SPI, PWM, Ethernet, USB 3,
# MIPI CSI-2 camera front-end, and DSI/DPI/VEC display outputs).
CONFIG_MFD_RP1=y
CONFIG_COMMON_CLK_RP1=y
CONFIG_COMMON_CLK_RP1_SDIO=y
CONFIG_PINCTRL_RP1=y
CONFIG_PWM=y
CONFIG_PWM_RP1=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_SPI=y
CONFIG_SPI_DESIGNWARE=y
CONFIG_SPI_DW_DMA=y
CONFIG_SPI_DW_MMIO=y
CONFIG_MACB=y
CONFIG_BROADCOM_PHY=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_HOST=y
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_RP1_CFE=y
CONFIG_DRM_RP1_DSI=y
CONFIG_DRM_RP1_DPI=y
CONFIG_DRM_RP1_VEC=y
