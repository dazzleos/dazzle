.{
    .name = .dazzle,
    .version = "0.0.0",
    .fingerprint = 0x2f81ae1020b5eecd, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.1",
    .dependencies = .{
        // The toolkit Dazzle is moving to (built without its own window
        // and render backends: Dazzle gives its own, in src/kete_vc4).
        .kete = .{ .path = "../kete" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tools",
    },
}
