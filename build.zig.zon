.{
    .name = .dazzle,
    .version = "0.0.0",
    .fingerprint = 0x2f81ae1020b5eecd, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.1",
    .dependencies = .{
        // The toolkit Dazzle is moving to (built without its own window
        // and render backends: Dazzle gives its own, in src/kete_vc4).
        // To build with a kete checkout beside Dazzle's instead:
        // `scripts/zig build --fork=../kete`.
        .kete = .{
            .url = "git+https://github.com/robert-ancell/kete#683610f84912ec8d8d4264f1396c0e86b4ca27ed",
            .hash = "kete-0.1.0-tp3h6oXMVACD_KZCpgUyol1I6u6bFJGxzDvVJUVGDUWj",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tools",
        // For apps in repositories of their own (see build.zig, `addApp`).
        "fonts",
        "notices",
        // Natural Earth's countries, for the world map.
        "data",
        "LICENSE",
    },
}
