.{
    .name = .dazzle,
    .version = "0.0.0",
    .fingerprint = 0x2f81ae1020b5eecd, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.1",
    .dependencies = .{
        // The toolkit Dazzle is moving to (built without its own window
        // and render backends: Dazzle gives its own, in src/kete_vc4).
        // To build with a kete checkout beside Dazzle's instead:
        // `scripts/zig build --fork=../kete`.
        .kete = .{
            .url = "git+https://github.com/robert-ancell/kete#df3ea7ae0e339e3e5d443958209b7af919096b84",
            .hash = "kete-0.1.0-tp3h6kBOUQDGj7fFfk7K-WL-e3X_gP9WdJowTp-WrVMP",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tools",
    },
}
